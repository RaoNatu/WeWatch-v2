rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function room(code) { return get(/databases/$(database)/documents/rooms/$(code)); }
    function isMember(code) {
      return signedIn() && request.auth.uid in room(code).data.memberUids;
    }

    match /rooms/{code} {
      // Exact room lookups are needed to join by code; collection listing is never allowed.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberCount == 1;
      allow update: if (
        isMember(code) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playback'])
            && request.auth.uid == resource.data.hostUid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playbackCommand'])
            && (request.auth.uid == resource.data.hostUid || resource.data.playbackControlsEnabled == true)
            && request.resource.data.playbackCommand.by == request.auth.uid
            && request.resource.data.playbackCommand.action in ['play', 'pause', 'seek']
            && (request.resource.data.playbackCommand.action != 'seek'
              || request.resource.data.playbackCommand.position is number))
          || (request.auth.uid == resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playbackControlsEnabled']))
          || (request.auth.uid == resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pingRequest']))
          || (request.auth.uid == resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ping']))
          || (request.auth.uid != resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pingReply'])
            && request.resource.data.pingReply.nonce == resource.data.pingRequest.nonce)
          || (request.auth.uid != resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount'])
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && request.auth.uid in resource.data.memberUids
            && !(request.auth.uid in request.resource.data.memberUids)
            && request.resource.data.memberCount == request.resource.data.memberUids.size())
        )
      ) || (
          signedIn()
          &&
          resource.data.memberUids.size() < 6
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 6
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'playback', 'playbackCommand'])
          && request.resource.data.playbackCommand.by == request.auth.uid
          && request.resource.data.playbackCommand.action == 'pause'
          && request.resource.data.playbackCommand.position is number
          && request.resource.data.playback.paused == true
          && request.resource.data.playback.position == request.resource.data.playbackCommand.position
          && request.resource.data.playback.updatedBy == resource.data.hostUid
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;

      match /members/{memberUid} {
        allow get, list: if isMember(code);
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/rooms/$(code)).data.memberUids;
        allow update: if signedIn()
          && memberUid == request.auth.uid
          && isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'playback']);
        allow delete: if signedIn() && (
          (memberUid == request.auth.uid && isMember(code))
          || room(code).data.hostUid == request.auth.uid
        );
      }
    }
  }
}
